      "title": "Ugnsstekt rotfruktsgryta",
      "servings": 4,
      "timeMinutes": 55,
      "difficulty": "lätt",
      "tags": ["vegetarisk", "ugn", "vinter"],
      "ingredients": [
        {"amount": "4 st", "name": "morötter"},
        {"amount": "2 st", "name": "palsternackor"},
        {"amount": "1 st", "name": "lök"},
        {"amount": "2 msk", "name": "olja"},
        {"amount": "1 tsk", "name": "salt"},
        {"amount": "1 kvist", "name": "timjan"}
      ],
      "steps": [
        "Sätt ugnen på 200 grader.",
        "Skär rotfrukter och lök i grova bitar.",
        "Blanda med olja, salt och timjan i en form.",
